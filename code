    # ---------------- UI 响应与逻辑 ----------------
    @Slot(np.ndarray, int, str, tuple)
    def on_frame_processed(self, cv_img, angle, status, color_rgb):
        self.current_frame = cv_img.copy()

        # 图像转为 QPixmap 渲染
        h, w, ch = cv_img.shape
        bytes_per_line = ch * w
        q_img = QImage(cv_img.data, w, h, bytes_per_line, QImage.Format_BGR888)
        pixmap = QPixmap.fromImage(q_img)
        self.video_label.setPixmap(
            pixmap.scaled(self.video_label.size(), Qt.KeepAspectRatio, Qt.SmoothTransformation)
        )

        # 更新仪表盘
        self.angle_display.setText(f"{angle}°")
        self.status_box.setText(status)
        r, g, b = color_rgb
        self.status_box.setStyleSheet(f"""
            background-color: rgba({r}, {g}, {b}, 0.2);
            color: rgb({r}, {g}, {b});
            border: 1px solid rgb({r}, {g}, {b});
            border-radius: 6px;
            font-weight: bold;
            font-size: 16px;
            padding: 8px;
        """)

    def switch_to_camera(self):
        self.thread.set_source("camera")
        self.mode_badge.setText("CAMERA MODE")
        self.mode_badge.setObjectName("BadgeCamera")
        self.mode_badge.setStyle(self.mode_badge.style())

    def switch_to_video(self):
        file_path, _ = QFileDialog.getOpenFileName(self, "选择本地投篮视频", "", "Video Files (*.mp4 *.avi *.mov)")
        if file_path:
            self.thread.set_source("video", file_path)
            self.mode_badge.setText("VIDEO MODE")
            self.mode_badge.setObjectName("BadgeVideo")
            self.mode_badge.setStyle(self.mode_badge.style())

    def toggle_pause(self):
        is_paused = self.thread.toggle_pause()
        self.btn_pause.setText("▶️ 继续" if is_paused else "⏸️ 暂停")

    def capture_snapshot(self):
        if self.current_frame is not None:
            save_name = os.path.join(SAVE_FOLDER, f"snap_{int(time.time())}.jpg")
            cv2.imwrite(save_name, self.current_frame)
            self.refresh_gallery()

    def keyPressEvent(self, event):
        if event.key() == Qt.Key_S:
            self.capture_snapshot()
        elif event.key() == Qt.Key_Space:
            self.toggle_pause()
        else:
            super().keyPressEvent(event)

    def refresh_gallery(self):
        # 清除现有缩略图
        for i in reversed(range(self.gallery_layout.count())): 
            widget = self.gallery_layout.itemAt(i).widget()
            if widget:
                widget.setParent(None)

        files = sorted([f for f in os.listdir(SAVE_FOLDER) if f.endswith(('.jpg', '.png'))], reverse=True)
        for idx, file_name in enumerate(files[:10]):  # 最多展示前 10 张
            file_path = os.path.join(SAVE_FOLDER, file_name)
            pixmap = QPixmap(file_path).scaled(110, 80, Qt.KeepAspectRatio, Qt.SmoothTransformation)
            
            lbl = QLabel()
            lbl.setPixmap(pixmap)
            lbl.setStyleSheet("border: 1px solid #3a3f58; border-radius: 4px;")
            
            row = idx // 2
            col = idx % 2
            self.gallery_layout.addWidget(lbl, row, col)

    def closeEvent(self, event):
        self.thread.stop()
        event.accept()

