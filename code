# =====================【配置与连接预设】=====================
VIDEO_FILE_DEFAULT = "curry_shoot.mp4"
SAVE_FOLDER = "capture_snap"

if not os.path.exists(SAVE_FOLDER):
    os.makedirs(SAVE_FOLDER)

CUSTOM_POSE_CONNECTIONS = [
    (11, 12), (11, 23), (12, 24), (23, 24),
    (11, 13), (13, 15), (12, 14), (14, 16),
    (23, 25), (25, 27), (24, 26), (26, 28),
    (15, 17), (15, 19), (15, 21), (16, 18), (16, 20), (16, 22),
    (27, 29), (27, 31), (28, 30), (28, 32)
]

def calculate_angle(a, b, c):
    a, b, c = np.array(a), np.array(b), np.array(c)
    ba = a - b
    bc = c - b
    cos_angle = np.dot(ba, bc) / (np.linalg.norm(ba) * np.linalg.norm(bc) + 1e-6)
    cos_angle = np.clip(cos_angle, -1.0, 1.0)
    raw_angle = np.arccos(cos_angle) * 180.0 / np.pi
    return int(min(raw_angle, 180 - raw_angle))


# =====================【后台视频处理线程】=====================
class ProcessingThread(QThread):
    # 传递 (绘制后的帧, 角度, 状态文本, 颜色RGB元组)
    frame_processed = Signal(np.ndarray, int, str, tuple)
    
    def __init__(self):
        super().__init__()
        self.running = True
        self.is_pause = False
        self.source_type = "camera"  # "camera" 或 "video"
        self.video_path = VIDEO_FILE_DEFAULT
        self.cap = None

        # 初始化 MediaPipe
        self.mp_pose = mp.solutions.pose
        self.pose = self.mp_pose.Pose(
            static_image_mode=False,
            model_complexity=1,
            smooth_landmarks=True,
            min_detection_confidence=0.6,
            min_tracking_confidence=0.6
        )

    def run(self):
        self._init_cap()
        pause_frame = None

        while self.running:
            if not self.cap or not self.cap.isOpened():
                time.sleep(0.03)
                continue

            if not self.is_pause:
                ret, raw_frame = self.cap.read()
                if not ret:
                    if self.source_type == "video":
                        # 循环播放视频
                        self.cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
                        continue
                    else:
                        time.sleep(0.03)
                        continue
                pause_frame = raw_frame.copy()
            else:
                if pause_frame is not None:
                    raw_frame = pause_frame.copy()
                else:
                    time.sleep(0.03)
                    continue

            frame = cv2.resize(raw_frame, (1280, 720))
            h, w, _ = frame.shape

            image = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            image.flags.writeable = False
            results = self.pose.process(image)
            image.flags.writeable = True
            image = cv2.cvtColor(image, cv2.COLOR_RGB2BGR)

            elbow_angle = 0
            status = "WAITING..."
            color = (150, 150, 150)

            if results.pose_landmarks:
                landmarks = results.pose_landmarks.landmark
                try:
                    shoulder = [landmarks[self.mp_pose.PoseLandmark.RIGHT_SHOULDER].x * w,
                                landmarks[self.mp_pose.PoseLandmark.RIGHT_SHOULDER].y * h]
                    elbow = [landmarks[self.mp_pose.PoseLandmark.RIGHT_ELBOW].x * w,
                             landmarks[self.mp_pose.PoseLandmark.RIGHT_ELBOW].y * h]
                    wrist = [landmarks[self.mp_pose.PoseLandmark.RIGHT_WRIST].x * w,
                             landmarks[self.mp_pose.PoseLandmark.RIGHT_WRIST].y * h]

                    elbow_angle = calculate_angle(shoulder, elbow, wrist)
                    elbow_pos = (int(elbow[0]) + 15, int(elbow[1]) - 15)
                    cv2.putText(image, f"{elbow_angle} deg", elbow_pos,
                                cv2.FONT_HERSHEY_SIMPLEX, 1.0, (0, 255, 255), 2, cv2.LINE_AA)

                    if 80 <= elbow_angle <= 110:
                        status = "EXCELLENT FORM"
                        color = (46, 204, 113) # 绿色
                    elif 60 <= elbow_angle < 80 or 110 < elbow_angle <= 130:
                        status = "ACCEPTABLE"
                        color = (241, 196, 15) # 黄色
                    else:
                        status = "NEEDS ADJUSTMENT"
                        color = (231, 76, 60) # 红色
                except Exception:
                    pass

                # 绘制无面部关键点骨架
                lm_list = results.pose_landmarks.landmark
                for (start_idx, end_idx) in CUSTOM_POSE_CONNECTIONS:
                    s_lm, e_lm = lm_list[start_idx], lm_list[end_idx]
                    sx, sy = int(s_lm.x * w), int(s_lm.y * h)
                    ex, ey = int(e_lm.x * w), int(e_lm.y * h)
                    cv2.line(image, (sx, sy), (ex, ey), (235, 64, 52), 3)

                for idx in range(11, len(lm_list)):
                    lm = lm_list[idx]
                    cx, cy = int(lm.x * w), int(lm.y * h)
                    cv2.circle(image, (cx, cy), 4, (0, 255, 255), -1)

            self.frame_processed.emit(image, elbow_angle, status, color)
            time.sleep(0.01)

    def _init_cap(self):
        if self.cap and self.cap.isOpened():
            self.cap.release()
        if self.source_type == "camera":
            self.cap = cv2.VideoCapture(0)
            self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, 1280)
            self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
        else:
            self.cap = cv2.VideoCapture(self.video_path)

    def set_source(self, source_type, path=None):
        self.source_type = source_type
        if path:
            self.video_path = path
        self._init_cap()

    def toggle_pause(self):
        self.is_pause = not self.is_pause
        return self.is_pause

    def stop(self):
        self.running = False
        if self.cap and self.cap.isOpened():
            self.cap.release()
        self.wait()


